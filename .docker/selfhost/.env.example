# =============================================
# AFFiNE Self-Hosted - Environment Variables
# Copy to .env va sua cac gia tri cho phu hop
# =============================================

# --- AFFiNE Core ---

# AFFiNE version (stable hoac specific tag)
AFFINE_REVISION=stable

# Internal port (khong doi)
PORT=3010

# Production mode (required: fixes AI provider hostname resolution in Docker)
NODE_ENV=production

# Data paths
UPLOAD_LOCATION=/opt/affine/storage
CONFIG_LOCATION=/opt/affine/config
DB_DATA_LOCATION=/opt/affine/postgres/pgdata

# --- Database ---

DB_USERNAME=affine
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DB_DATABASE=affine

# --- Chatbot ---

CHATBOT_PORT=3099
KNOWLEDGE_DIR=/app/knowledge

# --- NVIDIA NIM AI ---

# Lay key tu https://build.nvidia.com
NIM_API_KEY=nvapi-YOUR_KEY_HERE
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_LLM_MODEL=meta/llama-3.1-70b-instruct
NIM_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
